# Phase 1 environment variables — copy to .env.local (gitignored) and fill in values
# Real values come from `pnpm supabase status` after running `pnpm supabase start`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>

# Database
# DATABASE_URL: connection pooler URL (port 6543 in prod; port 54322 in local dev)
# DATABASE_MIGRATION_URL: direct connection (port 5432 in prod; port 54322 in local dev) — required by drizzle-kit
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
