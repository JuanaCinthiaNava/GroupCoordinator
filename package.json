    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^1.226.0",
    "tailwindcss": "^4.0.0-beta.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
