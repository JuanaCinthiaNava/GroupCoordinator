    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.9",
    "next": "15.5.0",
    "next-intl": "^3.26.0",
    "next-safe-action": "^7.10.4",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.0",
